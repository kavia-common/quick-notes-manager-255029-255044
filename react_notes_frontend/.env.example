# React environment variables for Quick Notes (Champagne)
# Create a copy of this file named `.env` in the project root and fill values as needed.

# Supabase configuration (optional for local/offline mode)
# If either is missing, the app will fall back to localStorage and show an offline banner.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Feature flags (JSON string)
# - enableCharacterCount: show character counter (default true)
# - confirmOnDelete: ask confirmation before delete (default true)
# Example: {"enableCharacterCount": true, "confirmOnDelete": true}
REACT_APP_FEATURE_FLAGS={"enableCharacterCount":true,"confirmOnDelete":true}
